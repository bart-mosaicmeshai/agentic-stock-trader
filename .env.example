# API Keys
ALPHA_VANTAGE_API_KEY=your_api_key_here
FINNHUB_API_KEY=your_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here  # Required for LLM agent

# LLM Configuration
CLAUDE_MODEL=claude-3-haiku-20240307  # Fast and affordable (default). Use claude-3-5-sonnet-20241022 for better reasoning if available.

# Local LLM Configuration (for LM Studio)
LM_STUDIO_URL=http://localhost:1234/v1  # LM Studio default endpoint
LOCAL_MODEL=local-model  # Auto-detects loaded model in LM Studio

# Trading Configuration
TRADING_MODE=paper  # paper or live
INITIAL_CAPITAL=100000
RISK_TOLERANCE=moderate  # conservative, moderate, aggressive

# Trading Strategy
WATCHLIST=AAPL,GOOGL,MSFT,AMZN,TSLA  # Comma-separated list of symbols to trade
MAX_POSITION_SIZE=0.2  # Maximum 20% of portfolio per position
MIN_CONFIDENCE=0.6  # Minimum 60% confidence to execute trades

# MCP Configuration
MCP_SERVER_PORT=3000
